DirectorySlash Off

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets for 1 year
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Cache Next.js static files
<FilesMatch "^\._next">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Don't cache HTML or RSC payloads (.txt) — they are not build-versioned,
# so a stale .txt causes a buildId mismatch -> full-page nav to the .txt URL.
<FilesMatch "\.(html|txt)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Enable gzip for text files
<IfModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_dechunk Yes
  mod_gzip_item_include file \.(html|txt|xml|js|css|json)$
  mod_gzip_item_include handler ^cgi-script$
  mod_gzip_item_exclude mime ^image/
  mod_gzip_minimum_file_size 512
</IfModule>

RewriteEngine On
RewriteBase /

# A real browser navigation (Sec-Fetch-Dest: document) to an RSC payload (.txt)
# means a stale-build hard-nav: old cached JS bounced the user to the raw .txt.
# Send them to the clean URL so they get fresh HTML instead of raw code.
# Legit RSC fetch()es carry Sec-Fetch-Dest: empty -> untouched.
RewriteCond %{HTTP:Sec-Fetch-Dest} =document
RewriteRule ^(.*/)?index\.txt$ /$1 [R=302,L]

# Serve .html for extensionless URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 404 fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /404.html [L]